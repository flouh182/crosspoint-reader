diff --git a/src/util/CivilDate.h b/src/util/CivilDate.h
new file mode 100644
index 0000000..6603f6b
--- /dev/null
+++ b/src/util/CivilDate.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// Small calendar helpers shared by the Dashboard home and the reading stats.
+
+namespace civil {
+
+inline bool isLeap(int y) { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0; }
+
+inline int daysInMonth(int year, int month /*1-12*/) {
+  static const int d[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  return (month == 2 && isLeap(year)) ? 29 : d[month - 1];
+}
+
+// Days since 1970-01-01 (proleptic Gregorian). Used as a stable per-day key.
+inline int daysFromCivil(int y, int m /*1-12*/, int d) {
+  y -= m <= 2;
+  const int era = (y >= 0 ? y : y - 399) / 400;
+  const unsigned yoe = static_cast<unsigned>(y - era * 400);
+  const unsigned mp = static_cast<unsigned>(m > 2 ? m - 3 : m + 9);
+  const unsigned doy = (153 * mp + 2) / 5 + static_cast<unsigned>(d) - 1;
+  const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + static_cast<int>(doe) - 719468;
+}
+
+// Weekday with Monday = 0 ... Sunday = 6 for a day number from daysFromCivil.
+inline int weekdayMonFirst(int dayNumber) {
+  // 1970-01-01 was a Thursday (index 3 with Monday = 0).
+  int w = (dayNumber + 3) % 7;
+  if (w < 0) w += 7;
+  return w;
+}
+
+}  // namespace civil
diff --git a/src/util/SunTimes.h b/src/util/SunTimes.h
new file mode 100644
index 0000000..04aed37
--- /dev/null
+++ b/src/util/SunTimes.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cmath>
+
+// Offline sunrise/sunset (NOAA general solar position equations, accurate to
+// about a minute at mid latitudes). Pure math: no clock, no network.
+
+struct SunTimes {
+  bool valid = false;
+  int riseMin = 0;  // minutes after local midnight
+  int setMin = 0;
+};
+
+inline SunTimes computeSunTimes(float latDeg, float lonDeg, int year, int month, int day, int utcOffsetMin) {
+  static const int cum[] = {0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334};
+  const bool leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;
+  const int doy = cum[month - 1] + day + ((leap && month > 2) ? 1 : 0);
+
+  const double kPi = 3.14159265358979323846;
+  const double g = 2.0 * kPi / (leap ? 366.0 : 365.0) * (doy - 1);
+  const double eqTime = 229.18 * (0.000075 + 0.001868 * std::cos(g) - 0.032077 * std::sin(g) -
+                                  0.014615 * std::cos(2 * g) - 0.040849 * std::sin(2 * g));
+  const double decl = 0.006918 - 0.399912 * std::cos(g) + 0.070257 * std::sin(g) - 0.006758 * std::cos(2 * g) +
+                      0.000907 * std::sin(2 * g) - 0.002697 * std::cos(3 * g) + 0.00148 * std::sin(3 * g);
+  const double lat = latDeg * kPi / 180.0;
+  double c = std::cos(90.833 * kPi / 180.0) / (std::cos(lat) * std::cos(decl)) - std::tan(lat) * std::tan(decl);
+  SunTimes out;
+  if (c < -1.0 || c > 1.0) return out;  // polar day/night: no rise/set
+  const double haDeg = std::acos(c) * 180.0 / kPi;
+  const double riseUtc = 720.0 - 4.0 * (lonDeg + haDeg) - eqTime;
+  const double setUtc = 720.0 - 4.0 * (lonDeg - haDeg) - eqTime;
+  out.riseMin = static_cast<int>(std::lround(riseUtc)) + utcOffsetMin;
+  out.setMin = static_cast<int>(std::lround(setUtc)) + utcOffsetMin;
+  out.valid = true;
+  return out;
+}
