diff --git a/src/ReadingStats.cpp b/src/ReadingStats.cpp
new file mode 100644
index 0000000..82a80b4
--- /dev/null
+++ b/src/ReadingStats.cpp
@@ -0,0 +1,102 @@
+#include "ReadingStats.h"
+
+#include <Arduino.h>
+#include <HalClock.h>
+#include <HalStorage.h>
+#include <Logging.h>
+
+#include <cstring>
+#include <ctime>
+
+#include "util/CivilDate.h"
+
+ReadingStats readingStats;
+
+namespace {
+constexpr const char* STATS_DIR = "/.crosspoint";
+constexpr const char* STATS_PATH = "/.crosspoint/reading_stats.bin";
+constexpr const char* STATS_TMP = "/.crosspoint/reading_stats.bin.tmp";
+constexpr uint32_t MIN_SESSION_SECONDS = 10;  // ignore accidental opens
+}  // namespace
+
+int ReadingStats::todayNumber() {
+  struct tm t;
+  if (!halClock.isAvailable() || !halClock.localTime(t)) return -1;
+  return civil::daysFromCivil(t.tm_year + 1900, t.tm_mon + 1, t.tm_mday);
+}
+
+void ReadingStats::ensureLoaded() {
+  if (loaded) return;
+  loaded = true;
+  for (auto& e : entries) e = {-1, 0};
+
+  HalFile f;
+  if (!Storage.openFileForRead("STATS", STATS_PATH, f)) return;
+  FileData data;
+  if (f.read(&data, sizeof(data)) != static_cast<int>(sizeof(data)) || data.magic != MAGIC) {
+    LOG_ERR("STATS", "Ignoring unreadable stats file");
+    return;
+  }
+  memcpy(entries, data.entries, sizeof(entries));
+}
+
+void ReadingStats::add(int day, uint32_t seconds) {
+  int slot = -1;
+  int oldest = 0;
+  for (int i = 0; i < KEPT_DAYS; i++) {
+    if (entries[i].day == day) {
+      slot = i;
+      break;
+    }
+    if (entries[i].day < entries[oldest].day) oldest = i;
+  }
+  if (slot < 0) {
+    slot = oldest;  // an empty slot (day = -1) is always the "oldest"
+    entries[slot] = {day, 0};
+  }
+  entries[slot].seconds += seconds;
+}
+
+void ReadingStats::save() {
+  FileData data;
+  data.magic = MAGIC;
+  memcpy(data.entries, entries, sizeof(entries));
+
+  Storage.mkdir(STATS_DIR);
+  {
+    HalFile f;
+    if (!Storage.openFileForWrite("STATS", STATS_TMP, f)) return;
+    if (f.write(reinterpret_cast<const uint8_t*>(&data), sizeof(data)) != sizeof(data)) {
+      LOG_ERR("STATS", "Short write saving reading stats");
+      return;
+    }
+    f.flush();
+  }
+  Storage.remove(STATS_PATH);
+  if (!Storage.rename(STATS_TMP, STATS_PATH)) LOG_ERR("STATS", "Failed to move stats file into place");
+}
+
+void ReadingStats::beginSession() {
+  inSession = true;
+  sessionStartMs = millis();
+}
+
+void ReadingStats::endSession() {
+  if (!inSession) return;
+  inSession = false;
+  const uint32_t elapsed = static_cast<uint32_t>((millis() - sessionStartMs) / 1000UL);
+  if (elapsed < MIN_SESSION_SECONDS) return;
+  const int today = todayNumber();
+  if (today < 0) return;  // no clock: cannot attribute the time to a day
+  ensureLoaded();
+  add(today, elapsed);
+  save();
+}
+
+uint32_t ReadingStats::secondsOnDay(int dayNumber) {
+  ensureLoaded();
+  for (const auto& e : entries) {
+    if (e.day == dayNumber) return e.seconds;
+  }
+  return 0;
+}
diff --git a/src/ReadingStats.h b/src/ReadingStats.h
new file mode 100644
index 0000000..75a586b
--- /dev/null
+++ b/src/ReadingStats.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <cstdint>
+
+// Counts time spent inside the reader, per local calendar day, for the
+// Dashboard home's "this week" widget. Persisted to /.crosspoint/reading_stats.bin
+// (last 14 days only, so the file stays tiny).
+class ReadingStats {
+ public:
+  static constexpr int KEPT_DAYS = 14;
+
+  // Called from ReaderActivity::onEnter / onExit.
+  void beginSession();
+  void endSession();
+
+  // Seconds read on the given day number (see civil::daysFromCivil), 0 if none.
+  uint32_t secondsOnDay(int dayNumber);
+
+  // Day number of "today" in local time, or -1 when the clock is unavailable.
+  static int todayNumber();
+
+ private:
+  struct Entry {
+    int32_t day;
+    uint32_t seconds;
+  };
+  struct FileData {
+    uint32_t magic;
+    Entry entries[KEPT_DAYS];
+  };
+  static constexpr uint32_t MAGIC = 0x41545352;  // "RSTA"
+
+  Entry entries[KEPT_DAYS];
+  bool loaded = false;
+  bool inSession = false;
+  unsigned long sessionStartMs = 0;
+
+  void ensureLoaded();
+  void add(int day, uint32_t seconds);
+  void save();
+};
+
+extern ReadingStats readingStats;
+#define READING_STATS readingStats
