+
+// ---------------------------------------------------------------------------
+// Dashboard theme (see components/DashboardHome.*)
+// ---------------------------------------------------------------------------
+
+bool HomeActivity::dashboardActive() const {
+  // Portrait only: the tile layout is designed for the tall screen.
+  return UITheme::getInstance().hasDashboardHome() && renderer.getScreenWidth() < renderer.getScreenHeight();
+}
+
+void HomeActivity::loopDashboard() {
+  buttonNavigator.onNext([this] {
+    selectorIndex = ButtonNavigator::nextIndex(selectorIndex, DashboardHome::TILE_COUNT);
+    requestUpdate();
+  });
+  buttonNavigator.onPrevious([this] {
+    selectorIndex = ButtonNavigator::previousIndex(selectorIndex, DashboardHome::TILE_COUNT);
+    requestUpdate();
+  });
+
+  // Back keeps its usual home behaviour: resume the most recent book.
+  if (mappedInput.wasReleased(MappedInputManager::Button::Back) && hasContinueReading && !recentBooks.empty()) {
+    onRecentBookSelected(recentBooks[0].path);
+    return;
+  }
+
+  // Touch boards (X4 Pro): tapping a tile opens it directly.
+  int tapX = 0, tapY = 0;
+  if (mappedInput.wasScreenTapped(tapX, tapY)) {
+    const int tile = DashboardHome::tileAt(renderer, tapX, tapY);
+    if (tile >= 0) {
+      selectorIndex = tile;
+      if (tile == DashboardHome::TILE_SETTINGS) {
+        onSettingsOpen();
+      } else {
+        onLibraryOpen();
+      }
+      return;
+    }
+  }
+
+  if (mappedInput.wasReleased(MappedInputManager::Button::Confirm)) {
+    if (selectorIndex == DashboardHome::TILE_SETTINGS) {
+      onSettingsOpen();
+    } else {
+      onLibraryOpen();
+    }
+    return;
+  }
+
+  // Keep the clock honest: redraw when the minute changes. (One partial
+  // refresh per minute while Home is open; the device still auto-sleeps.)
+  uint8_t h = 0, m = 0;
+  if (halClock.isAvailable() && halClock.getTime(h, m) && m != lastDrawnMinute) {
+    lastDrawnMinute = m;
+    requestUpdate();
+  }
+}
+
+void HomeActivity::renderDashboard() {
+  DashboardHome::draw(renderer, selectorIndex);
+
+  const auto labels = mappedInput.mapLabels(hasContinueReading ? tr(STR_RESUME) : "", tr(STR_SELECT), tr(STR_DIR_UP),
+                                            tr(STR_DIR_DOWN));
+  GUI.drawButtonHints(renderer, labels.btn1, labels.btn2, labels.btn3, labels.btn4);
+
+  renderer.displayBuffer(cleanInitialRefresh && !firstRenderDone ? HalDisplay::HALF_REFRESH : HalDisplay::FAST_REFRESH);
+  firstRenderDone = true;
+}
