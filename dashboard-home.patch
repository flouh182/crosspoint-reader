diff --git a/src/components/DashboardHome.cpp b/src/components/DashboardHome.cpp
new file mode 100644
index 0000000..38df8e6
--- /dev/null
+++ b/src/components/DashboardHome.cpp
@@ -0,0 +1,356 @@
+#include "DashboardHome.h"
+
+#include <GfxRenderer.h>
+#include <HalClock.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <ctime>
+
+#include "CrossPointSettings.h"
+#include "ReadingStats.h"
+#include "components/UITheme.h"
+#include "components/icons/library.h"
+#include "components/icons/settings2.h"
+#include "fontIds.h"
+#include "util/CivilDate.h"
+#include "util/SunTimes.h"
+
+namespace {
+
+// German labels. Edit these arrays for another language.
+const char* const kMonths[12] = {"Januar", "Februar", "Maerz",     "April",   "Mai",      "Juni",
+                                 "Juli",   "August",  "September", "Oktober", "November", "Dezember"};
+const char* const kWeekdayShort[7] = {"Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"};
+const char* const kWeekLetters[7] = {"M", "D", "M", "D", "F", "S", "S"};
+const char* const kTileBookshelf = "Bibliothek";
+const char* const kTileSettings = "Einstellungen";
+const char* const kThisWeek = "Diese Woche";
+const char* const kSunrise = "Aufgang";
+const char* const kSunset = "Untergang";
+
+constexpr int kGap = 8;
+constexpr int kFrameRadius = 10;
+
+struct Clock {
+  bool valid = false;
+  struct tm t {};
+};
+
+// UTC offset (minutes) currently in effect for the configured timezone,
+// derived from the same local time the clock shows.
+int utcOffsetMinutes(const struct tm& local) {
+  struct tm copy = local;
+  const time_t epoch = mktime(&copy);  // interprets `copy` under the active TZ rule
+  struct tm utc {};
+  gmtime_r(&epoch, &utc);
+  int diff = (local.tm_hour - utc.tm_hour) * 60 + (local.tm_min - utc.tm_min);
+  const int dayDiff = local.tm_yday - utc.tm_yday;
+  if (dayDiff == 1 || dayDiff < -1) diff += 1440;
+  if (dayDiff == -1 || dayDiff > 1) diff -= 1440;
+  return diff;
+}
+
+void frame(const GfxRenderer& r, int x, int y, int w, int h, int lineWidth = 2) {
+  r.drawRoundedRect(x, y, w, h, lineWidth, kFrameRadius, true);
+}
+
+void drawCentered(const GfxRenderer& r, int fontId, int cx, int y, const char* text, bool black = true,
+                  EpdFontFamily::Style style = EpdFontFamily::REGULAR) {
+  r.drawText(fontId, cx - r.getTextWidth(fontId, text, style) / 2, y, text, black, style);
+}
+
+// ---------------------------------------------------------------- calendar
+void drawCalendar(const GfxRenderer& r, int x, int y, int w, int h, const Clock& clk) {
+  const int cellW = w / 7;
+  const int cellH = std::min(h / 7, r.getLineHeight(SMALL_FONT_ID) + 14);
+  const int lh = r.getLineHeight(SMALL_FONT_ID);
+
+  for (int i = 0; i < 7; i++) {
+    drawCentered(r, SMALL_FONT_ID, x + i * cellW + cellW / 2, y + (cellH - lh) / 2, kWeekLetters[i], true,
+                 EpdFontFamily::BOLD);
+  }
+  if (!clk.valid) return;
+
+  const int year = clk.t.tm_year + 1900;
+  const int month = clk.t.tm_mon + 1;
+  const int firstIdx = civil::weekdayMonFirst(civil::daysFromCivil(year, month, 1));
+  const int dim = civil::daysInMonth(year, month);
+
+  for (int d = 1; d <= dim; d++) {
+    const int idx = firstIdx + d - 1;
+    const int cx = x + (idx % 7) * cellW;
+    const int cy = y + (idx / 7 + 1) * cellH;
+    char num[4];
+    snprintf(num, sizeof(num), "%d", d);
+    if (d == clk.t.tm_mday) {
+      r.fillRect(cx + 1, cy + 1, cellW - 2, cellH - 2, true);
+      drawCentered(r, SMALL_FONT_ID, cx + cellW / 2, cy + (cellH - lh) / 2, num, false, EpdFontFamily::BOLD);
+    } else {
+      drawCentered(r, SMALL_FONT_ID, cx + cellW / 2, cy + (cellH - lh) / 2, num);
+    }
+  }
+}
+
+// --------------------------------------------------------------- flip clock
+// Seven-segment masks, bit order a b c d e f g (0 = a ... 6 = g). 10 = dash.
+constexpr uint8_t kSegMask[11] = {63, 6, 91, 79, 102, 109, 125, 7, 127, 111, 64};
+
+void drawSegDigit(const GfxRenderer& r, int x, int y, int dw, int dh, int t, int digit) {
+  const uint8_t m = kSegMask[digit < 0 || digit > 10 ? 10 : digit];
+  const int half = (dh - 3 * t) / 2;
+  if (m & 1) r.fillRect(x + t, y, dw - 2 * t, t, true);                         // a
+  if (m & 2) r.fillRect(x + dw - t, y + t, t, half, true);                      // b
+  if (m & 4) r.fillRect(x + dw - t, y + 2 * t + half, t, half, true);          // c
+  if (m & 8) r.fillRect(x + t, y + dh - t, dw - 2 * t, t, true);               // d
+  if (m & 16) r.fillRect(x, y + 2 * t + half, t, half, true);                  // e
+  if (m & 32) r.fillRect(x, y + t, t, half, true);                             // f
+  if (m & 64) r.fillRect(x + t, y + t + half, dw - 2 * t, t, true);            // g
+}
+
+void drawFlipCard(const GfxRenderer& r, int x, int y, int w, int h, int value /*0-99, -1 = dashes*/) {
+  frame(r, x, y, w, h);
+  const int pad = 9;
+  const int dw = (w - 3 * pad) / 2;
+  const int dh = h - 2 * pad;
+  const int t = std::max(4, dw / 4);
+  const int tens = value < 0 ? 10 : value / 10;
+  const int ones = value < 0 ? 10 : value % 10;
+  drawSegDigit(r, x + pad, y + pad, dw, dh, t, tens);
+  drawSegDigit(r, x + 2 * pad + dw, y + pad, dw, dh, t, ones);
+  // The "hinge" of the flip card.
+  r.fillRect(x + 2, y + h / 2 - 1, w - 4, 2, false);
+}
+
+void drawClock(const GfxRenderer& r, int x, int y, int w, int h, const Clock& clk) {
+  const int lh = r.getLineHeight(UI_10_FONT_ID);
+  const int dateH = lh + 10;
+  const int cardsH = h - dateH - 4;
+  const int cardW = (w - 6) / 2;
+
+  int hour = -1, minute = -1;
+  if (clk.valid) {
+    hour = clk.t.tm_hour;
+    minute = clk.t.tm_min;
+    if (SETTINGS.clockFormat == 1) {  // 12h mode
+      hour %= 12;
+      if (hour == 0) hour = 12;
+    }
+  }
+  drawFlipCard(r, x, y, cardW, cardsH, hour);
+  drawFlipCard(r, x + cardW + 6, y, cardW, cardsH, minute);
+
+  const int lineY = y + cardsH + 4;
+  r.drawLine(x, lineY, x + w, lineY, true);
+  char date[12] = "--.--.";
+  const char* wd = "--";
+  if (clk.valid) {
+    snprintf(date, sizeof(date), "%02d.%02d.", clk.t.tm_mday, clk.t.tm_mon + 1);
+    wd = kWeekdayShort[(clk.t.tm_wday + 6) % 7];
+  }
+  r.drawText(UI_10_FONT_ID, x + 2, lineY + 4, date);
+  r.drawText(UI_10_FONT_ID, x + w - r.getTextWidth(UI_10_FONT_ID, wd) - 2, lineY + 4, wd);
+}
+
+// --------------------------------------------------------- weekly reading
+void drawStats(const GfxRenderer& r, int x, int y, int w, int h, const Clock& clk) {
+  frame(r, x, y, w, h);
+  const int pad = 10;
+  const int lhS = r.getLineHeight(SMALL_FONT_ID);
+  const int lhB = r.getLineHeight(UI_12_FONT_ID);
+
+  uint32_t secs[7] = {0, 0, 0, 0, 0, 0, 0};
+  int todayIdx = -1;
+  if (clk.valid) {
+    const int today = civil::daysFromCivil(clk.t.tm_year + 1900, clk.t.tm_mon + 1, clk.t.tm_mday);
+    todayIdx = civil::weekdayMonFirst(today);
+    for (int i = 0; i < 7; i++) secs[i] = READING_STATS.secondsOnDay(today - todayIdx + i);
+  }
+  uint32_t total = 0, best = 0;
+  for (int i = 0; i < 7; i++) {
+    total += secs[i];
+    best = std::max(best, secs[i]);
+  }
+  const uint32_t scale = std::max<uint32_t>(best, 30 * 60);  // full bar = max(best day, 30 min)
+
+  r.drawText(SMALL_FONT_ID, x + pad, y + pad, kThisWeek);
+  char val[16];
+  snprintf(val, sizeof(val), "%u min", static_cast<unsigned>(total / 60));
+  r.drawText(UI_12_FONT_ID, x + pad, y + pad + lhS, val, true, EpdFontFamily::BOLD);
+
+  const int barsTop = y + pad + lhS + lhB + 8;
+  const int barsBottom = y + h - pad - lhS - 3;
+  const int barH = std::max(10, barsBottom - barsTop);
+  const int gap = 3;
+  const int barW = (w - 2 * pad - 6 * gap) / 7;
+  for (int i = 0; i < 7; i++) {
+    const int bx = x + pad + i * (barW + gap);
+    r.drawRoundedRect(bx, barsTop, barW, barH, 1, 3, true);
+    if (secs[i] > 0) {
+      const int fill = std::max(3, static_cast<int>((barH - 4) * std::min<uint32_t>(secs[i], scale) / scale));
+      r.fillRect(bx + 2, barsTop + barH - 2 - fill, barW - 4, fill, true);
+    }
+    drawCentered(r, SMALL_FONT_ID, bx + barW / 2, barsBottom + 3, kWeekLetters[i], true,
+                 i == todayIdx ? EpdFontFamily::BOLD : EpdFontFamily::REGULAR);
+  }
+}
+
+// ------------------------------------------------------------------- tiles
+void drawTile(const GfxRenderer& r, int x, int y, int w, int h, const uint8_t* icon, const char* label,
+              bool selected) {
+  frame(r, x, y, w, h, selected ? 5 : 2);
+  const int lh = r.getLineHeight(UI_10_FONT_ID);
+  const int iconSize = 32;
+  const int blockH = iconSize + 10 + lh;
+  const int top = y + (h - blockH) / 2;
+  r.drawIcon(icon, x + (w - iconSize) / 2, top, iconSize);
+  drawCentered(r, UI_10_FONT_ID, x + w / 2, top + iconSize + 10, label);
+}
+
+// --------------------------------------------------------------------- sun
+void drawOctagon(const GfxRenderer& r, int cx, int cy, int rad) {
+  int xs[8], ys[8];
+  for (int i = 0; i < 8; i++) {
+    const double a = 3.14159265358979 / 4.0 * i + 3.14159265358979 / 8.0;
+    xs[i] = cx + static_cast<int>(std::lround(std::cos(a) * rad));
+    ys[i] = cy + static_cast<int>(std::lround(std::sin(a) * rad));
+  }
+  r.fillPolygon(xs, ys, 8, true);
+}
+
+void formatHm(char* buf, size_t n, int minutes) {
+  minutes = ((minutes % 1440) + 1440) % 1440;
+  snprintf(buf, n, "%02d:%02d", minutes / 60, minutes % 60);
+}
+
+void drawSun(const GfxRenderer& r, int x, int y, int w, int h, const Clock& clk) {
+  frame(r, x, y, w, h);
+  const int pad = 10;
+  const int lhS = r.getLineHeight(SMALL_FONT_ID);
+  const int lhB = r.getLineHeight(UI_12_FONT_ID);
+
+  SunTimes sun;
+  int nowMin = -1;
+  char date[12] = "--.--.";
+  if (clk.valid) {
+    sun = computeSunTimes(DashboardHome::LATITUDE, DashboardHome::LONGITUDE, clk.t.tm_year + 1900, clk.t.tm_mon + 1,
+                          clk.t.tm_mday, utcOffsetMinutes(clk.t));
+    nowMin = clk.t.tm_hour * 60 + clk.t.tm_min;
+    snprintf(date, sizeof(date), "%02d.%02d.", clk.t.tm_mday, clk.t.tm_mon + 1);
+  }
+  r.drawText(SMALL_FONT_ID, x + pad, y + pad, date);
+
+  const int timesY = y + h - pad - lhB;
+  const int labelsY = timesY - lhS;
+  const int curveTop = y + pad + lhS + 6;
+  const int baseY = labelsY - 8;
+  const int amp = std::max(12, baseY - curveTop - 4);
+  const int x0 = x + pad + 4;
+  const int x1 = x + w - pad - 4;
+  const double kPi = 3.14159265358979;
+
+  r.drawLine(x0 - 4, baseY, x1 + 4, baseY, true);
+  constexpr int kSteps = 24;
+  int px = x0, py = baseY;
+  for (int i = 1; i <= kSteps; i++) {
+    const int nx = x0 + (x1 - x0) * i / kSteps;
+    const int ny = baseY - static_cast<int>(std::lround(amp * std::sin(kPi * i / kSteps)));
+    r.drawLine(px, py, nx, ny, 2, true);
+    px = nx;
+    py = ny;
+  }
+  if (sun.valid && nowMin >= sun.riseMin && nowMin <= sun.setMin && sun.setMin > sun.riseMin) {
+    const double f = static_cast<double>(nowMin - sun.riseMin) / (sun.setMin - sun.riseMin);
+    drawOctagon(r, x0 + static_cast<int>((x1 - x0) * f), baseY - static_cast<int>(std::lround(amp * std::sin(kPi * f))), 6);
+  }
+
+  char rise[8] = "--:--", set[8] = "--:--";
+  if (sun.valid) {
+    formatHm(rise, sizeof(rise), sun.riseMin);
+    formatHm(set, sizeof(set), sun.setMin);
+  }
+  r.drawText(SMALL_FONT_ID, x + pad, labelsY, kSunrise);
+  r.drawText(UI_12_FONT_ID, x + pad, timesY, rise, true, EpdFontFamily::BOLD);
+  const int rightX = x + w - pad;
+  r.drawText(SMALL_FONT_ID, rightX - r.getTextWidth(SMALL_FONT_ID, kSunset), labelsY, kSunset);
+  r.drawText(UI_12_FONT_ID, rightX - r.getTextWidth(UI_12_FONT_ID, set, EpdFontFamily::BOLD), timesY, set, true,
+             EpdFontFamily::BOLD);
+}
+
+}  // namespace
+
+namespace {
+
+struct Box {
+  int x, y, w, h;
+};
+
+struct Layout {
+  Box calendar, clock, stats, bookshelf, sun, settings;
+};
+
+Layout computeLayout(const GfxRenderer& r) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int H = r.getScreenHeight();
+  const Rect content = UITheme::getInstance().getContentArea(r);
+
+  const int left = content.x + 10;
+  const int usableW = content.width - 20;
+  const int top = metrics.topPadding + metrics.headerHeight + 6;
+  // buttonHintsHeight is 0 on touch boards, so the grid grows to the bottom edge there.
+  const int bottom = H - metrics.buttonHintsHeight - 6;
+  const int totalH = bottom - top;
+
+  const int h1 = totalH * 38 / 100;
+  const int h2 = (totalH - h1 - 2 * kGap) / 2;
+  const int y1 = top;
+  const int y2 = y1 + h1 + kGap;
+  const int y3 = y2 + h2 + kGap;
+
+  const int w1L = usableW * 55 / 100;  // calendar | clock
+  const int w2L = usableW * 45 / 100;  // stats | bookshelf
+  const int w3L = usableW * 52 / 100;  // sun | settings
+
+  Layout l;
+  l.calendar = {left, y1, w1L, h1};
+  l.clock = {left + w1L + kGap, y1, usableW - w1L - kGap, h1};
+  l.stats = {left, y2, w2L, h2};
+  l.bookshelf = {left + w2L + kGap, y2, usableW - w2L - kGap, h2};
+  l.sun = {left, y3, w3L, h2};
+  l.settings = {left + w3L + kGap, y3, usableW - w3L - kGap, h2};
+  return l;
+}
+
+bool contains(const Box& b, int x, int y) { return x >= b.x && x < b.x + b.w && y >= b.y && y < b.y + b.h; }
+
+}  // namespace
+
+int DashboardHome::tileAt(const GfxRenderer& r, int x, int y) {
+  const Layout l = computeLayout(r);
+  if (contains(l.bookshelf, x, y)) return TILE_BOOKSHELF;
+  if (contains(l.settings, x, y)) return TILE_SETTINGS;
+  return -1;
+}
+
+void DashboardHome::draw(GfxRenderer& r, int selectedTile) {
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int W = r.getScreenWidth();
+
+  Clock clk;
+  clk.valid = halClock.isAvailable() && halClock.localTime(clk.t);
+
+  char title[32] = "Start";
+  if (clk.valid) snprintf(title, sizeof(title), "%s %d", kMonths[clk.t.tm_mon], clk.t.tm_year + 1900);
+  GUI.drawHeader(r, Rect{0, metrics.topPadding, W, metrics.headerHeight}, title, nullptr, false);
+
+  const Layout l = computeLayout(r);
+  drawCalendar(r, l.calendar.x, l.calendar.y, l.calendar.w, l.calendar.h, clk);
+  drawClock(r, l.clock.x, l.clock.y, l.clock.w, l.clock.h, clk);
+  drawStats(r, l.stats.x, l.stats.y, l.stats.w, l.stats.h, clk);
+  drawTile(r, l.bookshelf.x, l.bookshelf.y, l.bookshelf.w, l.bookshelf.h, LibraryIcon, kTileBookshelf,
+           selectedTile == TILE_BOOKSHELF);
+  drawSun(r, l.sun.x, l.sun.y, l.sun.w, l.sun.h, clk);
+  drawTile(r, l.settings.x, l.settings.y, l.settings.w, l.settings.h, Settings2Icon, kTileSettings,
+           selectedTile == TILE_SETTINGS);
+}
